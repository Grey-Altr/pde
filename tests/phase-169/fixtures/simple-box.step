ISO-10303-21;
HEADER;
FILE_DESCRIPTION(
/* description */ ('Simple Box CAD Model'),
/* implementation_level */ '2;1');
FILE_NAME(
/* name */ 'simple-box.step',
/* time_stamp */ '2026-03-29T05:00:00',
/* author */ ('PDE Test Fixture'),
/* organization */ ('Platform Development Engine'),
/* preprocessor_version */ 'PDE Phase 169',
/* originating_system */ 'CadQuery',
/* authorisation */ '');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
#1 = APPLICATION_PROTOCOL_DEFINITION(
  'draft international standard',
  'automotive_design',
  1997,
  #2);
#2 = APPLICATION_CONTEXT('core data for automotive mechanical design processes');
#3 = SHAPE_DEFINITION_REPRESENTATION(#4, #5);
#4 = PRODUCT_DEFINITION_SHAPE('', '', #6);
#5 = ADVANCED_BREP_SHAPE_REPRESENTATION('', (#7), #8);
#6 = PRODUCT_DEFINITION('design', '', #9, #10);
#7 = AXIS2_PLACEMENT_3D('', #11, #12, #13);
#8 = (GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#14)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#15, #16, #17)) REPRESENTATION_CONTEXT('Context #1', '3D Context with UNIT and UNCERTAINTY'));
#9 = PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE('', '', #18, .MADE.);
#10 = PRODUCT_DEFINITION_CONTEXT('part definition', #2, 'design');
#11 = CARTESIAN_POINT('', (0., 0., 0.));
#12 = DIRECTION('', (0., 0., 1.));
#13 = DIRECTION('', (1., 0., 0.));
#14 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001), #15, 'distance_accuracy_value', 'edge distance');
#15 = (NAMED_UNIT(*) SI_UNIT($,.METRE.) LENGTH_UNIT());
#16 = (NAMED_UNIT(*) SI_UNIT($,.RADIAN.) PLANE_ANGLE_UNIT());
#17 = (NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#18 = PRODUCT('box', 'box', '', (#19));
#19 = MECHANICAL_CONTEXT('', #2, 'mechanical');
ENDSEC;
END-ISO-10303-21;
